msgid_plural "According to its header file (.cbh), without opening its moves: {} records (games, and texts if it has some)"
msgstr[0] "D'après son fichier d'en-têtes (.cbh), sans ouvrir ses coups : {} enregistrement (une partie, ou un texte)"
msgstr[1] "D'après son fichier d'en-têtes (.cbh), sans ouvrir ses coups : {} enregistrements (des parties, et des textes s'il en a)"

