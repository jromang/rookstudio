msgstr ""

msgid "A WinBoard engine."
msgstr "Un motore WinBoard."

msgid "A always White"
msgstr "A sempre col Bianco"

msgid "A book from Lichess's evaluated positions"
msgstr ""

msgid "A book from Lichess's named openings"
msgstr ""

