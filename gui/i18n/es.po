msgid " — not a UCI engine? For a WinBoard engine, choose the WinBoard protocol."
msgstr " — ¿no es un motor UCI? Para un motor WinBoard, elige el protocolo WinBoard."

msgid "! {} pair with one game only"
msgid_plural "! {} pairs with one game only"
