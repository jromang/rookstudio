msgstr "%d · todas las jugadas por igual"

msgid "%d · moves by their weights"
msgstr "%d · jugadas según su peso"

msgid "%d · the best moves only"
msgstr "%d · solo las mejores jugadas"

msgid "%d · toward every move alike"
msgstr "%d · hacia todas las jugadas por igual"

