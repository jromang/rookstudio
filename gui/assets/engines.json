{
  "format": 1,
  "about": "The engines the engine picker offers, read by the program (docs/design/engine-picker.md). For each engine: its GitHub repository, its releases' tags and, by platform, its files from the fastest to the safest, each a regular expression of the whole file name ({ver}: a version) with what the processor must run (cpu_features.hpp, engine_catalogue.cpp). The program takes the first file the processor runs in the newest release that has one.",
  "engines": [
    {
      "id": "gaia",
      "name": "Gaia",
      "repo": "jromang/gaiachess",
      "licence": "GPL-3.0-or-later",
      "tag": "v?{ver}",
      "files": {
        "linux-x64": [
          {"asset": "gaiachess-linux-universal", "needs": "v3"},
          {"asset": "gaiachess-linux-compat", "needs": "x86-64"}
        ],
        "linux-arm64": [
          {"asset": "gaiachess-linux-neon", "needs": "arm64"}
        ],
        "windows-x64": [
          {"asset": "gaiachess-windows-console\\.exe", "needs": "v3"},
          {"asset": "gaiachess-windows-compat\\.exe", "needs": "x86-64"}
        ],
        "macos-arm64": [
          {"asset": "gaiachess-macos-apple-silicon", "needs": "arm64"}
        ]
      }
    },
    {
      "id": "stockfish",
      "name": "Stockfish",
      "repo": "official-stockfish/Stockfish",
      "licence": "GPL-3.0-or-later",
      "tag": "sf_{ver}",
      "files": {
        "linux-x64": [
          {"asset": "stockfish-linux-x86-64-universal\\.tar\\.gz", "needs": "x86-64",
