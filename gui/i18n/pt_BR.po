msgstr[0] "O final julgado pelas tablebases do Lichess: {} posição de sete peças ou menos, cada lance pelo que faz com o resultado exato."
msgstr[1] "O final julgado pelas tablebases do Lichess: {} posições de sete peças ou menos, cada lance pelo que faz com o resultado exato."

msgid "The endgame starts."
msgstr "O final começa."

