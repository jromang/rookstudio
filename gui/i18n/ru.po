msgstr "Партия %zu · тур %zu"

msgid "Game aborted"
msgstr "Партия отменена"

msgid "Game aborted: a first move did not come in time"
msgstr "Партия отменена: первый ход не был сделан вовремя"

msgid "Game annotated: evaluations and symbols · Ctrl+Z takes it back"
msgstr "Партия аннотирована: оценки и знаки · Ctrl+Z — отменить"

