        ],
        "linux-arm64": [
          {"asset": "stockfish-linux-arm64-universal\\.tar\\.gz", "needs": "arm64",
           "inside": "stockfish/stockfish-linux-arm64-universal"}
        ],
        "windows-x64": [
          {"asset": "stockfish-windows-x86-64-universal\\.zip", "needs": "x86-64",
