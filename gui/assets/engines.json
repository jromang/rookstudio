        ],
        "windows-arm64": [
          {"asset": "stockfish-windows-arm64-universal\\.zip", "needs": "arm64",
           "inside": "stockfish/stockfish-windows-arm64-universal\\.exe"}
        ],
        "macos-arm64": [
          {"asset": "stockfish-macos-universal\\.tar\\.gz", "needs": "arm64",
           "inside": "stockfish/stockfish-macos-universal"}
        ],
        "macos-x64": [
          {"asset": "stockfish-macos-universal\\.tar\\.gz", "needs": "x86-64",
           "inside": "stockfish/stockfish-macos-universal"}
        ]
